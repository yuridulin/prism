# Shared
PRISM_ENV=dev

# HTTP APIs
GO_API_PORT=8081
PYTHON_API_PORT=8082
GO_API_STORAGE=timescaledb
PYTHON_API_STORAGE=influxdb

# TimescaleDB
POSTGRES_USER=prism
POSTGRES_PASSWORD=prism
POSTGRES_DB=prism
POSTGRES_PORT=5432

# ClickHouse
CLICKHOUSE_USER=prism
CLICKHOUSE_PASSWORD=prism
CLICKHOUSE_DB=prism
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

# InfluxDB
INFLUX_USER=prism
INFLUX_PASSWORD=prismprism
INFLUX_ORG=prism
INFLUX_BUCKET=prism
INFLUX_TOKEN=prism-dev-token
INFLUX_PORT=8086

# VictoriaMetrics
VM_PORT=8428

# NATS
NATS_PORT=4222
NATS_MONITOR_PORT=8222
NATS_SUBJECT=prism.points

# Observability
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=prism
PROMETHEUS_PORT=9090

# Load profiles: iot-steady | high-cardinality | burst | query-mix
LOAD_PROFILE=iot-steady
# Optional overrides; empty keeps the profile defaults
GENERATOR_TARGET=
GENERATOR_DURATION=
