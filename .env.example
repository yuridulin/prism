# Shared
PRISM_ENV=dev

# HTTP APIs
GO_API_PORT=8081
PYTHON_API_PORT=8082
CSHARP_API_PORT=8083
RUST_API_PORT=8084
GO_API_STORAGE=questdb
PYTHON_API_STORAGE=questdb
CSHARP_API_STORAGE=questdb
RUST_API_STORAGE=questdb

# TimescaleDB
POSTGRES_USER=prism
POSTGRES_PASSWORD=prism
POSTGRES_DB=prism
POSTGRES_PORT=5432

# ClickHouse
CLICKHOUSE_USER=prism
CLICKHOUSE_PASSWORD=prism
CLICKHOUSE_DB=prism
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

# QuestDB (host 9001 → container 9000, чтобы не пересечься с ClickHouse native)
QUESTDB_HTTP_PORT=9001
QUESTDB_PG_PORT=8812
QUESTDB_ILP_PORT=9009
QUESTDB_METRICS_PORT=9003

# InfluxDB
INFLUX_USER=prism
INFLUX_PASSWORD=prismprism
INFLUX_ORG=prism
INFLUX_BUCKET=prism
INFLUX_TOKEN=prism-dev-token
INFLUX_PORT=8086

# VictoriaMetrics
VM_PORT=8428

# NATS
NATS_PORT=4222
NATS_MONITOR_PORT=8222
NATS_SUBJECT=prism.samples

# Observability
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=prism
PROMETHEUS_PORT=9090

# Load profiles: iot-steady | high-cardinality | burst | query-mix
LOAD_PROFILE=iot-steady
GENERATOR_TARGET=
GENERATOR_DURATION=
