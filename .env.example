# Shared
PRISM_ENV=dev

# HTTP APIs (matrix: Go / C# / Rust)
GO_API_PORT=8081
CSHARP_API_PORT=8083
RUST_API_PORT=8084
GO_API_STORAGE=questdb
CSHARP_API_STORAGE=questdb
RUST_API_STORAGE=questdb

# TimescaleDB
POSTGRES_USER=prism
POSTGRES_PASSWORD=prism
POSTGRES_DB=prism
POSTGRES_PORT=5432

# QuestDB (host 9001 → container 9000)
QUESTDB_HTTP_PORT=9001
QUESTDB_PG_PORT=8812
QUESTDB_ILP_PORT=9009
QUESTDB_METRICS_PORT=9003

# VictoriaMetrics
VM_PORT=8428

# NATS
NATS_PORT=4222
NATS_MONITOR_PORT=8222
NATS_SUBJECT=prism.samples

# Observability
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=prism
PROMETHEUS_PORT=9090

# Load profiles: iot-steady | high-cardinality | burst | query-mix
LOAD_PROFILE=iot-steady
GENERATOR_TARGET=
GENERATOR_DURATION=
