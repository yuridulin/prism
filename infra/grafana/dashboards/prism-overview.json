  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "title": "API request rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (backend, storage, route) (rate(prism_api_requests_total[30s]))",
          "legendFormat": "{{backend}} / {{storage}} / {{route}}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "title": "API latency p95",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, backend, storage, route) (rate(prism_api_request_duration_seconds_bucket[1m])))",
          "legendFormat": "{{backend}} / {{storage}} / {{route}}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "title": "Backend ingest (points/s)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (backend, storage, source) (rate(prism_backend_items_total{op=\"write\"}[30s]))",
          "legendFormat": "{{backend}} / {{storage}} / {{source}}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "title": "Backend op latency p95",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, backend, storage, op) (rate(prism_backend_op_duration_seconds_bucket[1m])))",
          "legendFormat": "{{backend}} / {{storage}} / {{op}}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "id": 5,
      "title": "Storage adapter latency p95",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, backend, storage, op) (rate(prism_storage_op_duration_seconds_bucket[1m])))",
          "legendFormat": "{{backend}} / {{storage}} / {{op}}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "max": 1, "min": 0 }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "id": 6,
      "title": "Storage up (from API ping)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "prism_storage_up",
          "legendFormat": "{{backend}} / {{storage}}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
