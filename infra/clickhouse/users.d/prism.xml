<clickhouse>
    <profiles>
        <default>
            <!-- Container envelope is 1 CPU / 1G; host nproc would oversubscribe. -->
            <max_threads>1</max_threads>
            <max_insert_threads>1</max_insert_threads>
            <!-- 200ms coalesces the 8 write-ceiling workers into fewer parts.
                 10ms minted tiny parts and tripped too-many-parts / async wait. -->
            <async_insert>1</async_insert>
            <wait_for_async_insert>1</wait_for_async_insert>
            <async_insert_busy_timeout_ms>200</async_insert_busy_timeout_ms>
            <async_insert_max_data_size>1048576</async_insert_max_data_size>
        </default>
    </profiles>
</clickhouse>
